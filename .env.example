# Limites e pausas
DAILY_CONNECTION_LIMIT=10
WAIT_SECONDS=15
SCROLL_PAUSE_SECONDS=1.0
MIN_INVITATION_PAUSE_SECONDS=3.0
MAX_INVITATION_PAUSE_SECONDS=8.0
BATCH_SIZE=10
MIN_BATCH_PAUSE_SECONDS=30.0
MAX_BATCH_PAUSE_SECONDS=60.0
MAX_BROWSER_RESTARTS_WITHOUT_SUGGESTIONS=1

# Chrome e perfil persistente (ajuste o caminho para o seu usuario)
CHROME_BINARY=/usr/bin/google-chrome
CHROME_USER_DATA_DIR=/home/your-user/.linkedin-selenium
CHROME_DEBUGGER_ADDRESS=127.0.0.1:9222
CHROMEDRIVER_LOG_PATH=logs/chromedriver.log
LOG_DIR=logs
LOG_LEVEL=INFO

# Execucao
DRY_RUN=false
KEEP_BROWSER_OPEN=true
